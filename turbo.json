{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "openapi": {
      "description": "Export the API's OpenAPI schema.",
      "outputs": ["openapi.json"]
    },
    "generate": {
      "description": "Generate code from upstream packages, e.g. the TypeScript API client from the OpenAPI schema.",
      "dependsOn": ["^openapi"],
      "outputs": ["src/schema.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^generate"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    }
  }
}
